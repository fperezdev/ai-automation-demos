      "id": "12c182dc-e16c-402c-b8fd-13a1f86f7d32",
      "name": "Process Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        220
      ],
      "webhookId": "demo-lead-process"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst lead = raw.body || raw;\nconst website = (lead.website || '').trim();\nreturn [{ json: {\n  lead,\n  website,\n  messages: [\n    { role: 'system', content: \"You are a B2B lead qualification analyst. Given a lead, return ONLY a JSON object: {\\\"score\\\": <0-100 integer>, \\\"tier\\\": \\\"HOT\\\"|\\\"WARM\\\"|\\\"COLD\\\", \\\"reasons\\\": [\\\"...\\\"], \\\"suggested_angle\\\": \\\"<one sentence on how to approach>\\\", \\\"followup_email\\\": \\\"<short, friendly follow-up email draft in English, 3-4 sentences>\\\"}. Score based on: clarity of need, company fit, budget signals and urgency in the message. The follow-up email must propose next steps over email or chat \\u2014 never suggest a phone or video call. No markdown, no commentary.\" },\n    { role: 'user', content: 'Lead data (JSON):\\n' + JSON.stringify(lead, null, 2) }\n  ]\n} }];\n"
      },
      "id": "763c3835-b71f-419e-9b66-809d6b947f0c",
      "name": "Build Research Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $input.first().json;\nlet siteText = '';\nconst url = (prev.website || '').trim();\nif (url) {\n  try {\n    const html = await this.helpers.httpRequest({ method: 'GET', url, timeout: 10000, encoding: 'utf8' });\n    siteText = String(html)\n      .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n      .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n      .replace(/<[^>]+>/g, ' ')\n      .replace(/\\s+/g, ' ')\n      .trim()\n      .slice(0, 5000);\n  } catch (e) {\n    siteText = '';\n  }\n}\nconst messages = prev.messages.slice();\nif (siteText) {\n  messages.push({ role: 'user', content: 'Website content for enrichment:\\n' + siteText });\n}\nreturn [{ json: { messages, website_text: siteText } }];\n"
      },
      "id": "e17fef9e-ce6b-4750-ac50-710c4543ddb8",
      "name": "Enrich Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8770/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messages: $json.messages, temperature: 0, response_format: { type: 'json_object' } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "e8ff01fc-c0e6-4551-9c2f-fbaefe05191f",
      "name": "LLM Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nlet content = (resp.choices && resp.choices[0] && resp.choices[0].message.content) || '';\ncontent = content.trim().replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\nconst start = content.indexOf('{');\nconst end = content.lastIndexOf('}');\nif (start === -1) throw new Error('LLM did not return JSON: ' + content.slice(0, 200));\nconst out = JSON.parse(content.slice(start, end + 1));\n\nconst lead = $('Process Lead').first().json.body;\nconst emailOk = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(lead.email || '');\nconst scoreOk = Number.isFinite(Number(out.score)) && Number(out.score) >= 0 && Number(out.score) <= 100;\nconst tierOk = ['HOT', 'WARM', 'COLD'].includes(String(out.tier).toUpperCase());\n\nreturn [{ json: {\n  score: Number(out.score),\n  tier: String(out.tier || '').toUpperCase(),\n  reasons: Array.isArray(out.reasons) ? out.reasons : [],\n  suggested_angle: out.suggested_angle || '',\n  followup_email: out.followup_email || '',\n  lead,\n  checks: [\n    { name: 'valid lead email', ok: emailOk, detail: lead.email || 'missing' },\n    { name: 'score in range 0-100', ok: scoreOk, detail: String(out.score) },\n    { name: 'tier is HOT/WARM/COLD', ok: tierOk, detail: String(out.tier) }\n  ]\n} }];\n"
      },
